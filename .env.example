# Gemini AI Key (required for AI Chat Assistant)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Base app URL
APP_URL="http://localhost:3000"

# Demo-only local testing flag. Leave disabled in production.
VITE_ENABLE_DEMO_ACCOUNTS="false"

# Admin-distributed role access codes for hardened auth.
# These should be shared privately with staff, clinic, and admin users only.
VITE_STAFF_ACCESS_CODE="STAFF-OHIMS-2026"
VITE_CLINIC_ACCESS_CODE="CLINIC-OHIMS-2026"
VITE_ADMIN_ACCESS_CODE="ADMIN-OHIMS-2026"

# ── Supabase ─────────────────────────────────────────────────────────
# Project URL (found in Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Anon / Public key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Service Role key (NEVER expose in frontend — server-side only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
